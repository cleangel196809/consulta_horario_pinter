# Copia este archivo como .env y ajusta los valores
POSTGRES_USER=pinter_admin
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=consulta_horario_pinter
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Clave secreta para firmar tokens JWT (genera una propia y aleatoria)
SECRET_KEY=cambia_esta_clave_secreta_super_larga
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Credenciales del usuario administrador inicial (se crea al levantar el contenedor)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_esta_clave_admin

# Credenciales de un usuario de prueba con rol "consulta" (solo lectura),
# tambien se crea automaticamente al levantar el contenedor por primera vez
TEST_USERNAME=consulta_prueba
TEST_PASSWORD=prueba123

# Credenciales de un usuario de prueba con rol "coordinador" (solo lectura,
# limitado a una facultad), tambien se crea automaticamente al levantar el
# contenedor por primera vez
COORD_USERNAME=coord_prueba
COORD_PASSWORD=coord123
COORD_FACULTAD_ALCANCE=SALUD

# Notificaciones por correo (OPCIONAL). Si dejas SMTP_HOST vacio, la
# aplicacion funciona igual pero el boton "Notificar por correo" del panel
# admin simplemente informara que el envio no esta configurado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-responder@pi.edu.co
SMTP_USE_TLS=true

# Carga automatica programada (OPCIONAL, ver backend/scripts/auto_import.py)
WATCH_DIR=/data/carga_automatica
PERIODO=
